OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TIMEOUT_MS=120000
PORT=3333
DATABASE_URL=
PUBLIC_BASE_URL=http://localhost:3333
FRONTEND_ORIGIN=http://localhost:5173
# Use virgulas quando a API precisar aceitar mais de um frontend.
FRONTEND_ORIGINS=http://localhost:5173

# Autenticacao. Use um segredo aleatorio com pelo menos 32 caracteres.
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=28800

# Seed opcional e idempotente do primeiro administrador.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

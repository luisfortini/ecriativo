{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test:tenant": "tsx --test src/tests/organizationRole.test.ts src/tests/editorialCalendar.test.ts",
    "test:studio": "tsx --test src/tests/brandContact.test.ts",
    "test:creation": "tsx --test src/tests/creationDirection.test.ts",
    "test:art-versions": "tsx --test src/tests/artVersion.test.ts",
    "smoke:art-versions": "tsx src/scripts/smokeArtVersions.ts",
    "smoke:creation": "tsx src/scripts/smokeCreation.ts",
    "test:campaign-corrections": "tsx --test src/tests/campaignCorrection.test.ts",
    "smoke:campaign-corrections": "tsx src/scripts/smokeCampaignCorrections.ts",
    "smoke:studio": "tsx src/scripts/smokeStudio.ts",
    "test:social-publishing": "tsx --test src/tests/socialPublishing.test.ts",
    "smoke:social-publishing": "tsx src/scripts/smokeSocialPublishing.ts",
    "test:editorial-output": "tsx --test src/tests/socialContentOutput.test.ts src/tests/socialBrandContract.test.ts src/tests/imageCanvas.test.ts",
    "smoke:content": "tsx src/scripts/smokeContent.ts",
    "backfill:media": "tsx src/scripts/backfillMedia.ts",
    "migrate-sqlite-to-postgres": "tsx src/scripts/migrateSqliteToPostgres.ts",
    "backup-db": "tsx src/scripts/backupDb.ts",
    "restore-db": "tsx src/scripts/restoreDb.ts",
    "smoke:improvements": "tsx src/scripts/smokeImprovements.ts"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.49",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "node-cron": "^4.2.1",
    "openai": "^5.0.1",
    "pg": "^8.21.0",
    "sharp": "^0.35.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.20.0",
    "better-sqlite3": "^11.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
